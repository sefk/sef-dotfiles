<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sefk.llmster</string>

	<!-- llmster-supervise.sh starts the daemon and its HTTP server, then
	     blocks health-checking both, so launchd has a real process to
	     supervise. It exits non-zero the moment either one fails and
	     KeepAlive brings it straight back.

	     This replaces a RunAtLoad-once, KeepAlive-false setup that fired
	     the two `lms` commands and exited. Those commands return
	     immediately, so launchd was supervising nothing: when llmster was
	     killed (last exit status -9, likely jetsam under the 27B model),
	     localhost:1234 stayed dead until the next login and ssrename sat
	     in its backend-unreachable backoff. -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/sefk/bin/llmster-supervise.sh</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<!-- If lms is fundamentally broken the wrapper exits immediately;
	     don't let launchd hot-loop on it. -->
	<key>ThrottleInterval</key>
	<integer>60</integer>

	<!-- llmster is spawned by the wrapper and so lands in this job's
	     process group. Without this, launchd SIGKILLs that whole group
	     when the wrapper exits — killing the very daemon the wrapper
	     exists to keep alive, and any in-flight request with it. -->
	<key>AbandonProcessGroup</key>
	<true/>

	<!-- launchd starts with a minimal PATH; give lms a sane one. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/sefk/.lmstudio/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/sefk/.lmstudio/llmster-launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/sefk/.lmstudio/llmster-launchd.log</string>
</dict>
</plist>
