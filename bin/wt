#!/usr/bin/env bash
#
# wt — sibling git worktrees for issue work.
#
#   wt <N> [slug]   create (or attach to) ../<repo>-<N>-<slug> on issue-<N>-<slug>,
#                   and cd there
#   wt ls           list this repo's worktrees
#   wt rm [N]       remove the worktree (default: the one you're in), and the
#                   branch if it's merged
#   wt path <N>     print the worktree path (for `cd "$(wt path 853)"`)
#   wt slug <N|text> [max]
#                   print the slug for an issue number or an arbitrary string
#
# Worktrees are siblings of the main checkout, never nested inside it: nesting
# puts them in the Docker build context, pytest's collection root, and every
# file watcher. The main checkout stays parked on the default branch.
#
# Per-repo settings come from an optional `.wtconfig` at the main checkout's
# root, sourced as shell. Recognized variables (defaults shown):
#
#   WT_LINK=".env .envrc"     untracked files symlinked back to the main
#                             checkout, so local config has one source of truth
#   WT_PORT_VAR=""            if set, wt writes "$WT_PORT_VAR=$port" into
#                             $WT_PORT_FILE, port = WT_PORT_BASE + (N % 1000)
#   WT_PORT_BASE=8000
#   WT_PORT_FILE=".env.worktree"
#   WT_SETUP=""               shell run inside the new worktree (e.g. "uv sync")
#   WT_SLUG_MAX=24            slug length cap, trimmed on a word boundary
#
# A worktree with an .envrc gets `direnv allow` run in it — a new path is a new
# direnv block even when .envrc is the main checkout's approved file.
#
# Share the one local service stack across worktrees — a distinct app port is
# enough. Don't stand up a second database per tree.
#
# A script can't cd its calling shell, so the `wt` shell function in
# bash_startup/wt.sh exports WT_CD_FILE; writing a path there moves the shell.
# Without the wrapper this degrades to printing where to go.

set -euo pipefail

die() { echo "wt: $*" >&2; exit 1; }

# Ask the calling shell to cd. Honored only under the `wt` shell function,
# which exports WT_CD_FILE; otherwise just tell the user where to go.
request_cd() {
  if [ -n "${WT_CD_FILE:-}" ]; then
    printf '%s' "$1" > "$WT_CD_FILE"
  else
    printf '  cd %s\n' "$1"
  fi
}

git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repository"

# The main worktree is always the first entry of `git worktree list`.
MAIN=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}')
[ -d "$MAIN" ] || die "could not locate the main worktree"
REPO=$(basename "$MAIN")
PARENT=$(dirname "$MAIN")

# --- per-repo config -------------------------------------------------------
WT_LINK=".env .envrc"
WT_PORT_VAR=""
WT_PORT_BASE=8000
WT_PORT_FILE=".env.worktree"
WT_SETUP=""
WT_SLUG_MAX=24
# shellcheck disable=SC1091
[ -f "$MAIN/.wtconfig" ] && . "$MAIN/.wtconfig"

default_branch() {
  local head
  head=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  if [ -n "$head" ]; then
    echo "${head#origin/}"
    return
  fi
  for b in main master; do
    git show-ref --verify --quiet "refs/heads/$b" && { echo "$b"; return; }
  done
  echo main
}

# Branch already associated with issue N, if any (local first, then remote).
existing_branch() {
  local n=$1
  git for-each-ref --format='%(refname:short)' "refs/heads/issue-$n-*" | head -1 && return
  git for-each-ref --format='%(refname:short)' "refs/remotes/origin/issue-$n-*" \
    | head -1 | sed 's|^origin/||'
}

# Filler words dropped from slugs — issue titles are full of them and they eat
# the character budget without helping you recognize the branch.
WT_STOPWORDS='a an and are as at be by for from in into is it its of on or that the this to when with some up'

# Title -> short branch-safe slug. Note -E: BSD sed has no \+ in a basic regex,
# and silently leaving the spaces in produces an invalid branch name.
slugify() {
  local s w out=""
  s=$(tr '[:upper:]' '[:lower:]' | sed -E -e 's/[^a-z0-9]+/-/g' -e 's/^-+//' -e 's/-+$//')

  # Drop stopwords, then keep whole words up to the length cap. Never return
  # empty: a title made entirely of stopwords keeps its first word.
  for w in ${s//-/ }; do
    case " $WT_STOPWORDS " in *" $w "*) continue ;; esac
    [ -z "$out" ] && { out="$w"; continue; }
    [ $(( ${#out} + 1 + ${#w} )) -le "$WT_SLUG_MAX" ] || break
    out="$out-$w"
  done
  [ -n "$out" ] || out="${s%%-*}"

  printf '%s' "${out:0:$WT_SLUG_MAX}"
}

# Path for a worktree that doesn't exist yet: ../<repo>-<N>-<slug>, so a
# directory listing tells you what each tree is for.
new_dest_for() {
  local n=$1 branch=$2
  echo "$PARENT/$REPO-$n-${branch#issue-$n-}"
}

# Path of the existing worktree for issue N, if any. Keyed off the branch, so
# it survives a renamed directory; falls back to matching the path, which also
# picks up the older slugless ../<repo>-<N> layout.
find_dest() {
  local n=$1 d
  git worktree list --porcelain | awk -v n="$n" '
    /^worktree /              { wt = substr($0, 10) }
    /^branch refs\/heads\//   { b = substr($0, 20)
                                if (b == "issue-" n || index(b, "issue-" n "-") == 1) {
                                  print wt; exit
                                } }'
}

# Path lookup as a fallback, for a tree git no longer lists or never branched
# to the convention.
find_dest_by_path() {
  local n=$1 d
  for d in "$PARENT/$REPO-$n" "$PARENT/$REPO-$n-"*; do
    [ -d "$d" ] && { printf '%s' "$d"; return 0; }
  done
  return 1
}

resolve_dest() {
  local n=$1 d
  d=$(find_dest "$n")
  [ -n "$d" ] && { printf '%s' "$d"; return 0; }
  find_dest_by_path "$n"
}

# Expose slugify, so callers that want a different budget than the branch name
# (herdr workspace labels, say) don't reimplement the truncation.
cmd_slug() {
  local input=${1:?usage: wt slug <N|text> [max]}
  WT_SLUG_MAX=${2:-$WT_SLUG_MAX}
  case "$input" in
    ''|*[!0-9]*) printf '%s\n' "$(printf '%s' "$input" | slugify)" ;;
    *)
      command -v gh >/dev/null 2>&1 || die "gh not available to look up issue $input"
      printf '%s\n' "$(gh issue view "$input" --json title --jq .title 2>/dev/null | slugify)"
      ;;
  esac
}

cmd_ls() {
  git worktree list
}

cmd_path() {
  local n=${1:?usage: wt path <N>}
  local d; d=$(resolve_dest "$n") || true
  [ -n "$d" ] && [ -d "$d" ] || die "no worktree for issue $n"
  echo "$d"
}

cmd_rm() {
  local n=${1:-} d branch here

  if [ -n "$n" ]; then
    d=$(resolve_dest "$n") || true
    [ -n "$d" ] && [ -d "$d" ] || die "no worktree for issue $n"
  else
    # No argument: the worktree you're standing in.
    d=$(git rev-parse --show-toplevel 2>/dev/null) \
      || die "not inside a worktree; pass an issue number"
    [ "$d" != "$MAIN" ] \
      || die "that's the main checkout ($MAIN), not a worktree; pass an issue number"
    git worktree list --porcelain | grep -qxF "worktree $d" \
      || die "$d is not a registered worktree of $REPO"
  fi

  # git worktree remove refuses on a dirty tree; say why first, since the
  # no-argument form means you may not have looked at it in a while.
  local dirty; dirty=$(git -C "$d" status --porcelain)
  if [ -n "$dirty" ]; then
    echo "wt: $d has uncommitted changes:" >&2
    printf '%s\n' "$dirty" | sed 's/^/  /' >&2
    die "commit or discard them first"
  fi

  branch=$(git -C "$d" rev-parse --abbrev-ref HEAD)

  # Run from the main checkout: we may be deleting the directory we're in.
  here=$PWD
  git -C "$MAIN" worktree remove "$d"
  echo "removed $d"

  if git -C "$MAIN" branch -d "$branch" 2>/dev/null; then
    echo "deleted merged branch $branch"
  else
    echo "kept branch $branch (not merged; 'git branch -D $branch' to force)"
  fi

  # If the shell was sitting in what we just deleted, move it somewhere real.
  case "$here" in
    "$d"|"$d"/*) request_cd "$MAIN" ;;
  esac
}

cmd_add() {
  local n=$1 slug=${2:-}
  case "$n" in ''|*[!0-9]*) die "issue number must be numeric: $n" ;; esac

  local d; d=$(resolve_dest "$n") || true
  if [ -n "$d" ] && [ -d "$d" ]; then
    echo "worktree already exists: $d"
    request_cd "$d"
    return 0
  fi

  local base; base=$(default_branch)
  local main_head; main_head=$(git -C "$MAIN" rev-parse --abbrev-ref HEAD)
  if [ "$main_head" != "$base" ]; then
    echo "wt: warning — main checkout $MAIN is on '$main_head', not '$base'." >&2
    echo "wt:           park it on $base so worktrees branch from a clean base." >&2
  fi

  local branch; branch=$(existing_branch "$n")
  if [ -z "$branch" ]; then
    if [ -z "$slug" ] && command -v gh >/dev/null 2>&1; then
      slug=$(gh issue view "$n" --json title --jq .title 2>/dev/null | slugify)
    else
      slug=$(printf '%s' "$slug" | slugify)
    fi
    [ -n "$slug" ] || die "no branch for issue $n; pass a slug: wt $n <slug>"
    branch="issue-$n-$slug"
  fi
  d=$(new_dest_for "$n" "$branch")

  git fetch --quiet origin 2>/dev/null || true

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$d" "$branch"
  elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git worktree add "$d" --track -b "$branch" "origin/$branch"
  else
    local start="$base"
    git show-ref --verify --quiet "refs/remotes/origin/$base" && start="origin/$base"
    git worktree add "$d" -b "$branch" "$start"
  fi

  # Untracked local config: one source of truth in the main checkout.
  for f in $WT_LINK; do
    if [ -e "$MAIN/$f" ] && [ ! -e "$d/$f" ]; then
      ln -s "$MAIN/$f" "$d/$f"
      echo "linked $f -> $MAIN/$f"
    fi
  done

  if [ -n "$WT_PORT_VAR" ]; then
    local port=$(( WT_PORT_BASE + n % 1000 ))
    {
      echo "# Written by wt(1) — per-worktree overrides for issue $n."
      echo "$WT_PORT_VAR=$port"
    } > "$d/$WT_PORT_FILE"
    echo "wrote $WT_PORT_FILE with $WT_PORT_VAR=$port"
  fi

  # New worktree = new path = a fresh direnv block, even though .envrc is the
  # same file the main checkout already approved.
  if [ -e "$d/.envrc" ] && command -v direnv >/dev/null 2>&1; then
    if ( cd "$d" && direnv allow . >/dev/null 2>&1 ); then
      echo "direnv allow'd $d/.envrc"
    else
      echo "wt: warning — direnv allow failed; run it yourself in $d" >&2
    fi
  fi

  if [ -n "$WT_SETUP" ]; then
    echo "running: $WT_SETUP"
    ( cd "$d" && eval "$WT_SETUP" )
  fi

  echo
  echo "worktree $d on $branch"
  request_cd "$d"
}

case "${1:-}" in
  ''|-h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0" ;;
  ls)           shift; cmd_ls "$@" ;;
  slug)         shift; cmd_slug "$@" ;;
  rm)           shift; cmd_rm "${1:-}" ;;
  path)         shift; cmd_path "$@" ;;
  *)            cmd_add "$@" ;;
esac
