#!/bin/bash
#
# herdr-project-for [--ensure] [DIR] -- which herdr workspace a directory's
# work belongs in.
#
# Workspaces are projects (leafletter, datatalk, ...); a task is a tab inside
# one. Maps the repo that DIR (default: cwd) belongs to -- worktrees resolve
# to their main checkout -- onto a project label, and prints it. Unmapped
# repos use the repo's own basename.
#
# --ensure prints the workspace *id* instead, creating the workspace (rooted
# at the main checkout, not focused) when it doesn't exist yet.
#
# Use it as: herdr tab create --workspace "$(herdr-project-for --ensure "$dir")" ...

ensure=0
if [[ "${1:-}" == "--ensure" ]]; then ensure=1; shift; fi
dir="${1:-$PWD}"

common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
main=$(dirname "${common:-$dir/.git}")
repo=$(basename "$main")

case "$repo" in
    leafletter-app) project=leafletter ;;
    *)              project=$repo ;;
esac

if (( ! ensure )); then
    echo "$project"
    exit 0
fi

id=$(herdr workspace list 2>/dev/null |
     jq -r --arg p "$project" '.result.workspaces[] | select(.label == $p) | .workspace_id' | head -1)
if [[ -z "$id" ]]; then
    id=$(herdr workspace create --label "$project" --cwd "$main" --no-focus |
         jq -r '.result.workspace.workspace_id // empty')
fi
[[ -n "$id" ]] || { echo "herdr-project-for: could not find or create workspace $project" >&2; exit 1; }
echo "$id"
