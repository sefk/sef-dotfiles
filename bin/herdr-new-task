#!/usr/bin/env bash
#
# herdr-new-task -- scaffold a task workspace in Herdr with one keystroke.
#
# Bound to Ctrl-A n (prefix+n) via a `[[keys.command]]` popup in herdr/config.toml.
# Herdr runs this inside an interactive popup pane, so `read` has a real TTY, and
# injects HERDR_BIN_PATH plus HERDR_ACTIVE_PANE_CWD (the cwd of the pane you were
# on when you hit the key).
#
# Prompts for a task name, a directory, and a layout, then builds the workspace.
# Agents (claude, pi) are named after the workspace so the sidebar reads cleanly.
#
# ADDING A LAYOUT: add a menu line in show_menu(), then a `layout_<key>` function,
# then one `case` arm in build_layout(). Nothing else needs to change.
#
# Not `set -e`: on failure we want to print a message and pause so the popup
# doesn't vanish before you can read it.
set -uo pipefail

herdr="${HERDR_BIN_PATH:-herdr}"

# --- herdr helpers -------------------------------------------------------------

# split_pane <pane_id> <right|down> -> echoes the new pane id
split_pane() {
  local target="$1" direction="$2" out
  out=$("$herdr" pane split "$target" --direction "$direction" --cwd "$dir" --no-focus 2>/dev/null) || return 1
  printf '%s' "$out" | jq -r '.result.pane.pane_id // empty'
}

# start_agent <kind> <pane_id> [agent_arg...] -- launches the agent and names it after the task
start_agent() {
  local kind="$1" pane="$2"; shift 2
  printf '  starting %s (up to ~30s) ...\n' "$kind"
  if "$herdr" agent start "$kind" --kind "$kind" --pane "$pane" -- "$@" >/dev/null 2>&1; then
    "$herdr" agent rename "$pane" "$name" >/dev/null 2>&1 \
      || printf '  (warning: could not rename %s session)\n' "$kind"
  else
    printf '  (warning: %s did not start; that pane is a shell in %s)\n' "$kind" "$dir"
    sleep 2
  fi
}

# run_in <pane_id> <command...> -- submits a command line + Enter into a pane
run_in() {
  local pane="$1"; shift
  "$herdr" pane run "$pane" "$@" >/dev/null 2>&1 \
    || printf '  (warning: could not run %s)\n' "$1"
}

# resolve_dir <input> -- turn user input into a directory path.
#   empty            -> the default dir
#   an existing path -> used literally (tilde-expanded; absolute or relative to cwd)
#   anything else    -> an autojump query (type "datatalk", get the frequent match)
# On a miss, echoes the original input back so the caller reports "no such directory".
resolve_dir() {
  local input="$1"
  [[ -z "$input" ]] && { printf '%s' "$default_dir"; return; }
  input="${input/#\~/$HOME}"
  if [[ -d "$input" ]]; then printf '%s' "$input"; return; fi
  if command -v autojump >/dev/null 2>&1; then
    local j; j=$(autojump "$input" 2>/dev/null)
    if [[ -n "$j" && "$j" != "." && -d "$j" ]]; then printf '%s' "$j"; return; fi
  fi
  printf '%s' "$input"
}

# --- layouts -------------------------------------------------------------------
# Each takes the root (left) pane id. Splits use --no-focus so focus stays on the
# root pane, which is where the agent lands.

# claude left, zsh right
layout_claude_zsh() {
  local root="$1"
  split_pane "$root" right >/dev/null
  start_agent claude "$root"
}

# zsh left, zsh right
layout_zsh_zsh() {
  local root="$1"
  split_pane "$root" right >/dev/null
}

# single zsh
layout_zsh() {
  :
}

# pi left, btop right-top, zsh right-bottom
layout_pi_btop_zsh() {
  local root="$1" right
  right=$(split_pane "$root" right) || { printf '  (warning: right split failed)\n'; return; }
  # Splitting `right` downward makes `right` the top pane and returns the bottom.
  split_pane "$right" down >/dev/null
  run_in "$right" btop
  start_agent pi "$root"
}

show_menu() {
  printf '  layout:\n'
  printf '    1) claude left, zsh right   (default)\n'
  printf '    2) zsh left, zsh right\n'
  printf '    3) zsh\n'
  printf '    4) pi left, btop right-top, zsh right-bottom\n'
}

build_layout() {
  local choice="$1" root="$2"
  case "$choice" in
    1) layout_claude_zsh  "$root" ;;
    2) layout_zsh_zsh     "$root" ;;
    3) layout_zsh         "$root" ;;
    4) layout_pi_btop_zsh "$root" ;;
    *) printf '  unknown layout %s; using default.\n' "$choice"
       layout_claude_zsh "$root" ;;
  esac
}

# --- gather input --------------------------------------------------------------

default_dir="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
[[ -d "$default_dir" ]] || default_dir="$HOME"

printf '\n  new task\n  ────────\n\n'

read -r -p "  task name: " name
name="${name#"${name%%[![:space:]]*}"}"   # ltrim
name="${name%"${name##*[![:space:]]}"}"   # rtrim
if [[ -z "$name" ]]; then
  printf '\n  cancelled (no name).\n'
  sleep 1
  exit 0
fi

read -r -e -p "  directory or jump word [$default_dir]: " dir_input
dir=$(resolve_dir "$dir_input")
if [[ ! -d "$dir" ]]; then
  printf '\n  no such directory (and no autojump match): %s\n' "$dir_input"
  sleep 2
  exit 1
fi
# Show where a fuzzy jump landed so it never surprises silently.
if [[ -n "$dir_input" && "$dir" != "${dir_input/#\~/$HOME}" ]]; then
  printf '  -> %s\n' "$dir"
fi

printf '\n'
show_menu
read -r -p "  choice [1]: " choice
choice="${choice:-1}"

# --- build ---------------------------------------------------------------------

printf '\n  creating workspace "%s" in %s ...\n' "$name" "$dir"

created=$("$herdr" workspace create --label "$name" --cwd "$dir" --focus)
if [[ $? -ne 0 || -z "$created" ]]; then
  printf '  workspace create failed.\n'
  sleep 2
  exit 1
fi

root_pane=$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')
if [[ -z "$root_pane" ]]; then
  printf '  could not read root pane id from response.\n'
  sleep 2
  exit 1
fi

build_layout "$choice" "$root_pane"

printf '  done.\n'
sleep 1
