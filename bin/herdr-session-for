#!/bin/bash
#
# herdr-session-for [DIR] -- which herdr session a directory's work belongs in.
#
# Each project has its own herdr session and Ghostty window (bin/herdr-windows).
# Maps the repo that DIR (default: cwd) belongs to -- worktrees resolve to their
# main checkout -- onto a session name, and prints it. Falls back to "default"
# for unmapped repos and for mapped sessions that aren't running.
#
# Use it as: herdr --session "$(herdr-session-for "$dir")" workspace create ...

dir="${1:-$PWD}"

common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
repo=$(basename "$(dirname "${common:-$dir/.git}")")

case "$repo" in
    datatalk)       session=datatalk ;;
    leafletter-app) session=leafletter ;;
    *)              session=default ;;
esac

if [[ "$session" != default ]] &&
   ! herdr session list --json 2>/dev/null |
       jq -e --arg s "$session" '.sessions[] | select(.name == $s and .running)' >/dev/null; then
    session=default
fi
echo "$session"
