font-family = Menlo

# Mellow, grey background and pink cursor
# theme = Arthur
# theme = Treehouse
# Hacktober is kind of low contrast but satisfying
# theme = Hacktober
# theme = Synthwave
theme = Adventure

# Needed to fix ssh issues: https://ghostty.org/docs/help/terminfo
shell-integration-features = ssh-terminfo
# Let Ghostty's native Kitty keyboard protocol send a real shift+enter
# (CSI-u) so TUIs like pi map it to newline. The old `text:\x1b\r` rewrite
# turned shift+enter into alt+enter, which pi reads as "queue follow-up".
# keybind = shift+enter=text:\x1b\r
keybind = shift+page_up=unbind
keybind = shift+page_down=unbind

# herdr tab navigation on Cmd-[ / ]; Ghostty's own tabs stay on the default
# Cmd-Shift-[ / ], mirroring Chrome. Cmd chords never reach the pty, so send
# herdr's prefix chord (Ctrl-A [ / ]) as bytes; herdr/config.toml binds
# previous_tab/next_tab to those. Ghostty binds nothing to Cmd-[ / ] by default.
keybind = super+left_bracket=text:\x01\x5b
keybind = super+right_bracket=text:\x01\x5d

# Cmd-1..9 jump to herdr tab N: send Alt-N as a CSI-u sequence, which
# herdr/config.toml binds directly (switch_tab = alt+1..9). Ghostty's own tab switching moves to
# Cmd-Shift-1..9; Cmd-Shift-9 stays "last tab" like the Cmd-9 default.
keybind = super+digit_1=text:\x1b[49;3u
keybind = super+digit_2=text:\x1b[50;3u
keybind = super+digit_3=text:\x1b[51;3u
keybind = super+digit_4=text:\x1b[52;3u
keybind = super+digit_5=text:\x1b[53;3u
keybind = super+digit_6=text:\x1b[54;3u
keybind = super+digit_7=text:\x1b[55;3u
keybind = super+digit_8=text:\x1b[56;3u
keybind = super+digit_9=text:\x1b[57;3u
keybind = super+shift+digit_1=goto_tab:1
keybind = super+shift+digit_2=goto_tab:2
keybind = super+shift+digit_3=goto_tab:3
keybind = super+shift+digit_4=goto_tab:4
keybind = super+shift+digit_5=goto_tab:5
keybind = super+shift+digit_6=goto_tab:6
keybind = super+shift+digit_7=goto_tab:7
keybind = super+shift+digit_8=goto_tab:8
keybind = super+shift+digit_9=last_tab

# Allow remote apps (e.g. tmux on studio over ssh) to set the Mac clipboard via OSC 52.
clipboard-write = allow
clipboard-read = ask

split-divider-color=yellow

# uncomment this to start every shell in tmux
# command = ~/.config/ghostty/start-tmux.sh

