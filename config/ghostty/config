font-family = Menlo

# Mellow, grey background and pink cursor
# theme = Arthur
# theme = Treehouse
# Hacktober is kind of low contrast but satisfying
# theme = Hacktober
# theme = Synthwave
theme = Adventure

# Needed to fix ssh issues: https://ghostty.org/docs/help/terminfo
shell-integration-features = ssh-terminfo
# Let Ghostty's native Kitty keyboard protocol send a real shift+enter
# (CSI-u) so TUIs like pi map it to newline. The old `text:\x1b\r` rewrite
# turned shift+enter into alt+enter, which pi reads as "queue follow-up".
# keybind = shift+enter=text:\x1b\r
keybind = shift+page_up=unbind
keybind = shift+page_down=unbind

# herdr tab navigation on Cmd-Ctrl-[ / ] (browser muscle memory). Cmd chords
# never reach the pty, so send herdr's prefix chord (Ctrl-A [ / ]) as bytes;
# herdr/config.toml binds previous_tab/next_tab to those.
keybind = super+ctrl+left_bracket=text:\x01\x5b
keybind = super+ctrl+right_bracket=text:\x01\x5d

# Allow remote apps (e.g. tmux on studio over ssh) to set the Mac clipboard via OSC 52.
clipboard-write = allow
clipboard-read = ask

split-divider-color=yellow

# uncomment this to start every shell in tmux
# command = ~/.config/ghostty/start-tmux.sh

